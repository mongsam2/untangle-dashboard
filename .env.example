# 빠른 시작(dev 기록 보기): 이 파일을 .env로 복사하고 ADMIN_KEY만 채움. .env는 커밋하지 않음.
# 배포: 같은 값으로 `bun run build && bun run preview`(4173 포트). prod는 ADMIN_API_URL·ADMIN_KEY를 prod 값으로.

# 데이터 출처. live = 탱글의 /v2/dashboard API, mock = 서버 없이 내장 예시 데이터
VITE_API_MODE=live

# 백엔드 경유(dev): 백엔드 운영자 API(/api/v1/admin/tangle/dashboard/*)가 탱글로 중계함. 터널·AWS 자격 증명 불필요.
# ADMIN_KEY = 백엔드 운영자 키(SSM /untangle/dev/ADMIN_KEY). 담당자에게 1:1로 받음.
# 개발 서버 프록시가 X-Admin-Key 헤더로만 붙이고 브라우저로는 보내지 않음.
ADMIN_API_URL=https://dev-api.gbstudio.kr
ADMIN_KEY=

# 로컬 탱글 서버 직접 연결(개발자용): 위 ADMIN_API_URL을 지우거나 주석 처리하면 아래 값을 씀.
# TANGLE_DASHBOARD_TOKEN = 탱글 서버의 같은 이름 설정값과 같은 값.
# TANGLE_SERVER_URL=http://127.0.0.1:8010
# TANGLE_DASHBOARD_TOKEN=
