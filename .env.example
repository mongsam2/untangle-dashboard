# 빠른 시작: 이 파일을 .env로 복사하고 키를 채움. .env는 커밋하지 않음.
# Vercel 배포는 같은 이름을 Vercel 프로젝트의 Environment Variables에 넣음(README "Vercel 배포").

# 데이터 출처. live = 서버의 실행 기록, mock = 서버 없이 내장 예시 데이터
VITE_API_MODE=live

# 대시보드 접근 키(팀이 정한 우리만의 키). 화면에 들어올 때 이 값을 입력함. 16자 이상.
# 새로 만들 때: openssl rand -base64 24
DASHBOARD_ACCESS_KEY=

# 개발 서버: 백엔드 운영자 API(/api/v1/admin/tangle/dashboard/*)가 탱글로 중계함.
# DEV_ADMIN_KEY = 백엔드 운영자 키(SSM /untangle/dev/ADMIN_KEY). 담당자에게 1:1로 받음.
DEV_ADMIN_API_URL=https://dev-api.gbstudio.kr
DEV_ADMIN_KEY=

# 운영 서버: 운영 백엔드·탱글에 대시보드가 배포된 뒤부터 기록이 보임. 그 전에는 화면에 안내가 뜸.
# PROD_ADMIN_KEY = 백엔드 운영자 키(SSM /untangle/prod/ADMIN_KEY).
PROD_ADMIN_API_URL=https://api.gbstudio.kr
PROD_ADMIN_KEY=

# 운영자 키가 비어 있는 서버는 연결하지 않음(틀린 키 요청은 백엔드가 세어 잠시 막음).
# 운영자 키·탱글 토큰·접근 키는 서버 쪽에서만 쓰고 브라우저로 보내지 않음.

# 로컬 탱글 서버 직접 연결(개발자용): 백엔드 서버가 하나도 연결되지 않았거나 아래 주소가 있으면 '로컬' 서버로 붙음.
# TANGLE_DASHBOARD_TOKEN = 탱글 서버의 같은 이름 설정값과 같은 값.
# TANGLE_SERVER_URL=http://127.0.0.1:8010
# TANGLE_DASHBOARD_TOKEN=
