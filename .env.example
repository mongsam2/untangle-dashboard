# 데이터 출처. mock(기본) = 내장 예시 데이터, live = 탱글 서버의 /v1/dashboard API
VITE_API_MODE=mock

# live 모드 연결은 둘 중 하나다. ADMIN_API_URL이 있으면 백엔드 경유, 없으면 탱글 서버 직접.

# 1) 백엔드 경유(배포된 탱글): 백엔드 운영자 API가 탱글로 중계한다. 터널이 필요 없다.
#    ADMIN_KEY는 백엔드 운영자 키(SSM /untangle/{env}/ADMIN_KEY). 프록시가 X-Admin-Key 헤더로 붙이며 브라우저로는 보내지 않는다.
# ADMIN_API_URL=https://dev-api.gbstudio.kr
# ADMIN_KEY=

# 2) 탱글 서버 직접(로컬): 프록시가 /v1 요청을 넘길 탱글 서버 주소와 서버의 TANGLE_DASHBOARD_TOKEN과 같은 값.
TANGLE_SERVER_URL=http://127.0.0.1:8010
TANGLE_DASHBOARD_TOKEN=
